def guardar_para_finetuning(datos, nombre_archivo):
    with open(nombre_archivo, 'w', encoding='utf-8') as f:
        for entrada in datos:
            formato_ia = {
                "instruction": entrada["pregunta"],
                "input": "",
                "output": entrada["respuesta"]
            }
            f.write(json.dumps(formato_ia, ensure_ascii=False) + '\n')

# EJECUCIÓN
